{
  "name": "apprendre-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "next dev --turbopack -p 3100",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-flow.mjs",
    "verify:arch": "node scripts/verify-architecture.mjs",
    "verify": "npm run verify:arch && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "katex": "^0.16.45",
    "lucide-react": "^0.562.0",
    "next": "^15.5.29",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.65.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    }
  }
}
