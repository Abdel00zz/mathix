{
  "name": "mathix",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Mathix — Plateforme éditoriale de mathématiques (Élève + Admin Studio + moteurs Rust/WASM, prête pour Vercel)",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node server/server.mjs",
    "start": "node server/server.mjs",
    "build": "node scripts/build.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "build:vercel": "node scripts/build.mjs --dist",
    "audit": "node scripts/audit.mjs",
    "lint": "node scripts/audit.mjs",
    "check": "node scripts/audit.mjs && node scripts/build.mjs --dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
