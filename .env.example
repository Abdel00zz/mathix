# ============================================================================
# MathPlus / MathFlow — Configuration Cloud & Authentification
# Copier vers .env.local (dev Vite / Next.js) ou configurer dans Vercel.
# ============================================================================

# --- 1. L1 Cache & Etat Atomique : Upstash Redis REST ---
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
# Alias acceptes :
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- 2. Secrets de Session & Administration (fail-closed en production) ---
ACCOUNT_SESSION_SECRET=change-this-account-secret-to-a-long-random-value
PROF_SESSION_SECRET=change-this-professor-secret-to-another-long-random-value
ADMIN_SECRET=change-this-admin-secret
CRON_SECRET=change-this-cron-secret
PUSH_SECRET=change-this-push-secret

# --- 3. Google Identity Services (GIS OAuth Client ID Web) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Alias Next.js client :
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- 4. L2 Durable Store & Auth : Firebase + Cloud Firestore REST v1 ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alias Next.js publics :
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# --- 5. Notifications Web Push & Email (optionnel) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
