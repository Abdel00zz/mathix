# Compte de service Firebase Admin (gratuit dans Console Firebase → Paramètres → Comptes de service)
# Permet aux routes /api/* d'écrire platform/public et de lire les résumés élèves dans Firestore.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── 2. Upstash Redis / Vercel KV (couche cache chaude O(1), compteurs rev & rate-limit) ─
