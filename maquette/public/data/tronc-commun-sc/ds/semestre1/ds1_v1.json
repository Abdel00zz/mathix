      "id": "tds1s1v1-ex1",
      "number": 1,
      "theme": "ensembles de nombres",
      "points": 10,
      "topic": "Ensembles de nombres — $\\mathbb{N}$, $\\mathbb{Z}$, $\\mathbb{Q}$, $\\mathbb{R}$",
      "context": "",
      "questions": [
        {
          "id": "q1",
          "content": "Classification des nombres",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Classer les nombres suivants : $\\sqrt{9}$, $\\frac{7}{3}$, $\\pi$, $-5$, $\\sqrt{2}$.",
              "hint": "$\\sqrt{9} = 3 \\in \\mathbb{N}$, $\\frac{7}{3} \\in \\mathbb{Q} \\setminus \\mathbb{Z}$, $\\pi \\in \\mathbb{R} \\setminus \\mathbb{Q}$, $-5 \\in \\mathbb{Z}$, $\\sqrt{2} \\in \\mathbb{R} \\setminus \\mathbb{Q}$."
            },
            {
              "id": "sq1b",
              "content": "Montrer que $\\sqrt{3}$ est irrationnel.",
              "hint": "Par l'absurde : si $\\sqrt{3} = \\frac{p}{q}$ irréductible, alors $3q^2 = p^2$, donc $3 | p$, posons $p = 3k$, alors $q^2 = 3k^2$, $3 | q$. Contradiction."
            }
          ]
        },
        {
          "id": "q2",
          "content": "Intervalles et opérations",
          "subQuestions": [
            {
              "id": "sq2a",
              "content": "Déterminer $A \\cap B$ et $A \\cup B$ avec $A = [-3, 5]$ et $B = [1, 8[$.",
              "hint": "$A \\cap B = [1, 5]$ et $A \\cup B = [-3, 8[$."
            },
            {
              "id": "sq2b",
              "content": "Déterminer $\\overline{A}$ (complémentaire de $A$ dans $\\mathbb{R}$).",
              "hint": "$\\overline{A} = ]-\\infty, -3[ \\cup ]5, +\\infty[$."
            }
          ]
        }
      ]
    },
    {
      "id": "tds1s1v1-ex2",
      "number": 2,
      "theme": "ordre dans IR",
      "points": 10,
      "topic": "Ordre dans $\\mathbb{R}$ — Valeur absolue et encadrements",
      "context": "",
      "questions": [
        {
          "id": "q1",
          "content": "Valeur absolue",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Résoudre $|2x - 3| = 5$.",
              "hint": "$2x - 3 = 5 \\Rightarrow x = 4$ ou $2x - 3 = -5 \\Rightarrow x = -1$. $S = \\{-1, 4\\}$."
            },
            {
              "id": "sq1b",
              "content": "Résoudre $|x + 1| \\leq 3$.",
              "hint": "$-3 \\leq x + 1 \\leq 3$, soit $-4 \\leq x \\leq 2$. $S = [-4, 2]$."
            },
            {
              "id": "sq1c",
              "content": "Montrer que pour tous $a, b \\in \\mathbb{R}$ : $|a + b| \\leq |a| + |b|$.",
              "hint": "Inégalité triangulaire. On élève au carré : $(a+b)^2 \\leq (|a|+|b|)^2$ revient à $ab \\leq |ab|$ qui est toujours vrai."
            }
          ]
        },
        {
          "id": "q2",
          "content": "Encadrements",
          "subQuestions": [
            {
              "id": "sq2a",
              "content": "Sachant que $2 \\leq x \\leq 5$ et $-1 \\leq y \\leq 3$, encadrer $x + y$ et $x - y$.",
              "hint": "$1 \\leq x + y \\leq 8$ et $2 - 3 \\leq x - y \\leq 5 + 1$, soit $-1 \\leq x - y \\leq 6$."
            },
            {
              "id": "sq2b",
              "content": "Encadrer $xy$ sous les mêmes hypothèses.",
              "hint": "Attention : $y$ peut être négatif. Produits possibles : $2 \\cdot (-1) = -2$, $5 \\cdot 3 = 15$, $2 \\cdot 3 = 6$, $5 \\cdot (-1) = -5$. Donc $-5 \\leq xy \\leq 15$."
            }
          ]
        }
      ]
    }
  ]
}
