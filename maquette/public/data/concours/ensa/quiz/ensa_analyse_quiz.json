    {
      "id": "ensa-an-01",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "prompt": "La limite $\\displaystyle \\lim_{x \\to 0} \\frac{\\sqrt{1+x} - \\sqrt{1-x}}{x}$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$1$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\frac{1}{2}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "N'existe pas",
          "isCorrect": false
        }
      ],
      "explanation": "Multiplication par le conjugué : $\\frac{(1+x)-(1-x)}{x(\\sqrt{1+x}+\\sqrt{1-x})} = \\frac{2}{\\sqrt{1+x}+\\sqrt{1-x}} \\xrightarrow[x\\to 0]{} \\frac{2}{2} = 1$."
    },
    {
      "id": "ensa-an-02",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "prompt": "$\\displaystyle \\lim_{x \\to 0} \\frac{\\sin(3x)}{\\tan(5x)}$ vaut :",
