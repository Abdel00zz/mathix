  "exercises": [
    {
      "id": "natsm2024n-ex1",
      "number": 1,
      "theme": "arithmetique",
      "difficulty": "moyen",
      "points": 4,
      "topic": "Arithmétique — Congruences et divisibilité",
      "context": "",
      "questions": [
        {
          "id": "q1",
          "content": "Congruences",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Résoudre dans $\\mathbb{Z}$ la congruence $3x \\equiv 5 \\pmod{7}$.",
              "hint": "L'inverse de 3 modulo 7 est 5 car $3 \\times 5 = 15 \\equiv 1 \\pmod{7}$. Donc $x \\equiv 5 \\times 5 \\equiv 25 \\equiv 4 \\pmod{7}$."
            },
            {
              "id": "sq1b",
              "content": "Montrer que pour tout $n \\in \\mathbb{N}$, $7 \\mid 2^{3n} - 1$.",
              "hint": "$2^3 = 8 \\equiv 1 \\pmod{7}$, donc $2^{3n} = (2^3)^n \\equiv 1^n = 1 \\pmod{7}$."
            },
            {
              "id": "sq1c",
              "content": "Déterminer le PGCD de $2024$ et $756$ et écrire $d = 2024a + 756b$ avec $a, b \\in \\mathbb{Z}$.",
              "hint": "Algorithme d'Euclide : $2024 = 2 \\times 756 + 512$, $756 = 1 \\times 512 + 244$, ... Remonter les calculs pour Bézout."
            }
          ]
        }
      ]
    },
    {
      "id": "natsm2024n-ex2",
      "number": 2,
      "theme": "analyse",
      "difficulty": "difficile",
      "points": 5,
      "topic": "Analyse — Équations différentielles et intégrales",
      "context": "On considère l'équation différentielle $(E) : y' - 2y = e^{2x}$.",
      "questions": [
        {
          "id": "q1",
          "content": "Résolution de $(E)$",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Résoudre l'équation homogène associée $y' - 2y = 0$.",
              "hint": "Solutions : $y_h = Ce^{2x}$, $C \\in \\mathbb{R}$."
            },
            {
              "id": "sq1b",
              "content": "Chercher une solution particulière de la forme $y_p = axe^{2x}$.",
              "hint": "$y_p' = ae^{2x} + 2axe^{2x}$. En substituant : $ae^{2x} = e^{2x}$, donc $a = 1$."
            },
            {
              "id": "sq1c",
              "content": "En déduire la solution générale de $(E)$ et la solution vérifiant $y(0) = 3$.",
              "hint": "$y = (C + x)e^{2x}$. $y(0) = C = 3$, donc $y = (3+x)e^{2x}$."
            }
          ]
        },
        {
          "id": "q2",
          "content": "Calcul intégral",
          "subQuestions": [
            {
              "id": "sq2a",
              "content": "Calculer $I = \\int_0^1 xe^{2x} \\, dx$ par intégration par parties.",
              "hint": "Poser $u = x$, $dv = e^{2x}dx$. Alors $du = dx$, $v = \\frac{e^{2x}}{2}$."
            }
          ]
        }
      ]
    },
    {
      "id": "natsm2024n-ex3",
      "number": 3,
      "theme": "nombres-complexes",
      "difficulty": "difficile",
      "points": 4,
      "topic": "Nombres complexes — Racines de l'unité",
      "context": "Soit $j = e^{i\\frac{2\\pi}{3}}$.",
      "questions": [
        {
          "id": "q1",
          "content": "Propriétés de $j$",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Montrer que $1 + j + j^2 = 0$.",
              "hint": "$j$ est racine de $z^3 - 1 = 0$, soit $(z-1)(z^2+z+1) = 0$. Comme $j \\neq 1$, $j^2 + j + 1 = 0$."
            },
            {
              "id": "sq1b",
              "content": "En déduire les valeurs de $j^2 + j$ et $(1-j)(1-j^2)$.",
              "hint": "$j^2 + j = -1$. $(1-j)(1-j^2) = 1 - j - j^2 + j^3 = 1 - (-1) + 1 = 3$."
            },
            {
              "id": "sq1c",
              "content": "Résoudre $z^3 = 8$ dans $\\mathbb{C}$.",
              "hint": "Les solutions sont $z_k = 2 e^{i\\frac{2k\\pi}{3}}$ pour $k = 0, 1, 2$. Soit $z_0 = 2$, $z_1 = 2j$, $z_2 = 2j^2$."
            }
          ]
        }
      ]
    },
    {
      "id": "natsm2024n-ex4",
      "number": 4,
      "theme": "probabilites",
      "difficulty": "moyen",
      "points": 3,
      "topic": "Probabilités conditionnelles",
      "context": "On lance un dé truqué dont les probabilités sont proportionnelles au numéro de la face.",
      "questions": [
        {
          "id": "q1",
          "content": "Loi du dé",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Déterminer $P(X = k)$ pour $k \\in \\{1, ..., 6\\}$.",
              "hint": "$P(X=k) = \\frac{k}{1+2+3+4+5+6} = \\frac{k}{21}$."
            },
            {
              "id": "sq1b",
              "content": "Calculer $E(X)$ et $V(X)$.",
              "hint": "$E(X) = \\sum_{k=1}^{6} k \\cdot \\frac{k}{21} = \\frac{1}{21} \\sum k^2 = \\frac{91}{21} = \\frac{13}{3}$."
            }
          ]
        }
      ]
    },
    {
      "id": "natsm2024n-ex5",
      "number": 5,
      "theme": "geometrie-espace",
      "difficulty": "difficile",
      "points": 4,
      "topic": "Géométrie dans l'Espace — Produit mixte",
      "context": "Dans un repère orthonormé, on donne $A(1,0,0)$, $B(0,2,0)$, $C(0,0,3)$, $D(1,1,1)$.",
      "questions": [
        {
          "id": "q1",
          "content": "Volume et distances",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Calculer le produit mixte $[\\overrightarrow{AB}, \\overrightarrow{AC}, \\overrightarrow{AD}]$.",
              "hint": "$\\overrightarrow{AB} = (-1,2,0)$, $\\overrightarrow{AC} = (-1,0,3)$, $\\overrightarrow{AD} = (0,1,1)$. Le produit mixte est le déterminant de la matrice formée par ces vecteurs."
            },
            {
              "id": "sq1b",
              "content": "En déduire le volume du tétraèdre $ABCD$.",
              "hint": "$V = \\frac{1}{6} |[\\overrightarrow{AB}, \\overrightarrow{AC}, \\overrightarrow{AD}]|$."
            },
            {
              "id": "sq1c",
              "content": "Déterminer l'aire du triangle $ABC$ et en déduire la distance de $D$ à $(ABC)$.",
              "hint": "Aire $= \\frac{1}{2} |\\overrightarrow{AB} \\wedge \\overrightarrow{AC}|$. Puis $V = \\frac{1}{3} \\times \\text{Aire} \\times h$, donc $h = \\frac{3V}{\\text{Aire}}$."
            }
          ]
        }
      ]
    }
  ]
}
