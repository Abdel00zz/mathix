  "exercises": [
    {
      "id": "ds2s1v1-ex1",
      "number": 1,
      "theme": "suites numériques",
      "points": 10,
      "topic": "Suites récurrentes — Convergence et monotonie",
      "context": "Soit $(u_n)$ la suite définie par $u_0 = 1$ et pour tout $n \\in \\mathbb{N}$ :\n$$u_{n+1} = \\frac{1}{3}u_n + 2$$",
      "questions": [
        {
          "id": "q1",
          "content": "Calculs et conjectures",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Calculer $u_1$, $u_2$ et $u_3$.",
              "hint": "$u_1 = \\frac{1}{3}(1) + 2 = \\frac{7}{3}$, $u_2 = \\frac{1}{3} \\cdot \\frac{7}{3} + 2 = \\frac{25}{9}$, $u_3 = \\frac{1}{3} \\cdot \\frac{25}{9} + 2 = \\frac{79}{27}$."
            },
            {
              "id": "sq1b",
              "content": "Montrer par récurrence que pour tout $n \\in \\mathbb{N}$, $u_n < 3$.",
              "hint": "**Initialisation** : $u_0 = 1 < 3$. **Hérédité** : Si $u_n < 3$, alors $u_{n+1} = \\frac{u_n}{3} + 2 < \\frac{3}{3} + 2 = 3$."
            },
            {
              "id": "sq1c",
              "content": "Montrer que $(u_n)$ est croissante.",
              "hint": "$u_{n+1} - u_n = \\frac{u_n}{3} + 2 - u_n = 2 - \\frac{2u_n}{3} = \\frac{2(3 - u_n)}{3} > 0$ car $u_n < 3$."
            },
            {
              "id": "sq1d",
              "content": "En déduire que $(u_n)$ est convergente et déterminer sa limite.",
              "hint": "$(u_n)$ est croissante et majorée par $3$, donc convergente. Si $\\ell = \\lim u_n$, alors $\\ell = \\frac{\\ell}{3} + 2$, soit $\\frac{2\\ell}{3} = 2$, d'où $\\ell = 3$."
            }
          ]
        }
      ]
    },
    {
      "id": "ds2s1v1-ex2",
      "number": 2,
      "theme": "logarithmes",
      "points": 10,
      "topic": "Fonction logarithme — Équations et inéquations",
      "questions": [
        {
          "id": "q1",
          "content": "Résolution d'équations",
          "subQuestions": [
            {
              "id": "sq1a",
              "content": "Résoudre dans $\\mathbb{R}$ l'équation $\\ln(x^2 - 3) = \\ln(2x)$.",
              "hint": "Condition : $x^2 - 3 > 0$ et $2x > 0 \\Rightarrow x > 0$ et $x > \\sqrt{3}$. Alors $x^2 - 3 = 2x \\Rightarrow x^2 - 2x - 3 = 0 \\Rightarrow (x-3)(x+1) = 0$. Seule $x = 3$ convient."
            },
            {
              "id": "sq1b",
              "content": "Résoudre dans $\\mathbb{R}$ l'inéquation $\\ln(x + 1) \\leq 1$.",
              "hint": "Condition : $x > -1$. $\\ln(x+1) \\leq 1 \\Leftrightarrow x + 1 \\leq e \\Leftrightarrow x \\leq e - 1$. Solution : $]-1, e-1]$."
            }
          ]
        }
      ]
    }
  ]
}
