      "topic": "Polynômes — Division euclidienne et racines",
      "context": "On considère le polynôme $P(x) = x^3 - 6x^2 + 11x - 6$.",
      "questions": [
        {
          "id": "q1",
          "content": "Factorisation",
          "subQuestions": [
            { "id": "sq1a", "content": "Vérifier que $1$ est racine de $P$.", "hint": "$P(1) = 1 - 6 + 11 - 6 = 0$ ✓." },
            { "id": "sq1b", "content": "Effectuer la division euclidienne de $P(x)$ par $(x-1)$.", "hint": "$P(x) = (x-1)(x^2 - 5x + 6)$." },
            { "id": "sq1c", "content": "Factoriser complètement $P(x)$.", "hint": "$x^2 - 5x + 6 = (x-2)(x-3)$. Donc $P(x) = (x-1)(x-2)(x-3)$." }
          ]
        },
        {
          "id": "q2",
          "content": "Résolution d'inéquation",
          "subQuestions": [
            { "id": "sq2a", "content": "Résoudre $P(x) \\geq 0$.", "hint": "Tableau de signes avec racines $1, 2, 3$. $P(x) \\geq 0$ sur $[1, 2] \\cup [3, +\\infty[$." },
            { "id": "sq2b", "content": "Résoudre $P(x) > 0$ dans $\\mathbb{N}$.", "hint": "Dans $\\mathbb{N}$ : $P(0) = -6 < 0$, $P(1) = 0$, $P(2) = 0$, $P(3) = 0$, $P(4) = 6 > 0$. Solutions : $\\{n \\in \\mathbb{N} : n \\geq 4\\} = \\{4, 5, 6, \\ldots\\}$." }
          ]
        }
      ]
    },
    {
      "id": "tds2s1v1-ex2",
      "number": 2,
      "theme": "équations et inéquations",
      "points": 10,
      "topic": "Équations et inéquations du second degré",
      "context": "",
      "questions": [
        {
          "id": "q1",
          "content": "Équation du second degré",
          "subQuestions": [
            { "id": "sq1a", "content": "Résoudre $2x^2 - 5x + 2 = 0$.", "hint": "$\\Delta = 25 - 16 = 9$. $x_1 = \\frac{5-3}{4} = \\frac{1}{2}$, $x_2 = \\frac{5+3}{4} = 2$." },
            { "id": "sq1b", "content": "Sans calculer les racines de $x^2 - 3x + 1 = 0$, déterminer $x_1^2 + x_2^2$.", "hint": "$x_1 + x_2 = 3$, $x_1 x_2 = 1$. $x_1^2 + x_2^2 = (x_1+x_2)^2 - 2x_1x_2 = 9 - 2 = 7$." }
          ]
        },
        {
          "id": "q2",
          "content": "Inéquations",
          "subQuestions": [
            { "id": "sq2a", "content": "Résoudre $\\frac{x+2}{x-1} \\leq 0$.", "hint": "Tableau de signes : $x+2 = 0$ si $x = -2$, $x-1 = 0$ si $x = 1$. Solution : $[-2, 1[$." },
            { "id": "sq2b", "content": "Résoudre $x^2 - 4x + 3 < 0$.", "hint": "$\\Delta = 4$, racines $1$ et $3$. Comme $a > 0$, $x^2 - 4x + 3 < 0$ sur $]1, 3[$." },
            { "id": "sq2c", "content": "Résoudre $\\sqrt{x+3} = x + 1$.", "hint": "Condition : $x \\geq -3$ et $x + 1 \\geq 0$, soit $x \\geq -1$. Élever au carré : $x + 3 = x^2 + 2x + 1$, $x^2 + x - 2 = 0$, $x = 1$ ou $x = -2$. Vérification : seul $x = 1$ convient." }
          ]
        }
      ]
    }
  ]
