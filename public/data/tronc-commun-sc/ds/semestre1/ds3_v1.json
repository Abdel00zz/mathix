    {
      "id": "tds3s1v1-ex1",
      "number": 1,
      "theme": "calcul vectoriel",
      "points": 10,
      "topic": "Calcul vectoriel dans le plan",
      "context": "On considère un repère orthonormé $(O, \\overrightarrow{i}, \\overrightarrow{j})$. Soient $A(1, 3)$, $B(4, -1)$ et $C(-2, 5)$.",
      "questions": [
        {
          "id": "q1",
          "content": "Vecteurs et colinéarité",
          "subQuestions": [
            { "id": "sq1a", "content": "Calculer les coordonnées de $\\overrightarrow{AB}$ et $\\overrightarrow{AC}$.", "hint": "$\\overrightarrow{AB} = (3, -4)$ et $\\overrightarrow{AC} = (-3, 2)$." },
            { "id": "sq1b", "content": "Les points $A$, $B$ et $C$ sont-ils alignés ? Justifier.", "hint": "$\\det(\\overrightarrow{AB}, \\overrightarrow{AC}) = 3 \\times 2 - (-4) \\times (-3) = 6 - 12 = -6 \\neq 0$. Non alignés." },
            { "id": "sq1c", "content": "Calculer $\\|\\overrightarrow{AB}\\|$ et en déduire la distance $AB$.", "hint": "$\\|\\overrightarrow{AB}\\| = \\sqrt{9 + 16} = 5$." }
          ]
        },
        {
          "id": "q2",
          "content": "Milieu et projection",
          "subQuestions": [
            { "id": "sq2a", "content": "Déterminer les coordonnées du milieu $I$ de $[AB]$.", "hint": "$I\\left(\\frac{1+4}{2}, \\frac{3-1}{2}\\right) = \\left(\\frac{5}{2}, 1\\right)$." },
            { "id": "sq2b", "content": "Déterminer le point $D$ tel que $ABCD$ soit un parallélogramme.", "hint": "$\\overrightarrow{DC} = \\overrightarrow{AB}$ donc $D = C - \\overrightarrow{AB} = (-2-3, 5+4) = (-5, 9)$." }
          ]
        }
      ]
    },
    {
      "id": "tds3s1v1-ex2",
      "number": 2,
      "theme": "droite dans le plan",
      "points": 10,
      "topic": "La droite dans le plan — Équations et positions relatives",
      "context": "",
      "questions": [
        {
          "id": "q1",
          "content": "Équations de droites",
          "subQuestions": [
            { "id": "sq1a", "content": "Déterminer une équation cartésienne de la droite $(AB)$ passant par $A(1, 2)$ et $B(3, -4)$.", "hint": "$\\overrightarrow{AB} = (2, -6)$. Vecteur normal : $(6, 2)$ ou $(3, 1)$. Équation : $3x + y - 5 = 0$." },
            { "id": "sq1b", "content": "Déterminer l'équation réduite de la droite $(D)$ : $2x - 4y + 8 = 0$.", "hint": "$-4y = -2x - 8$, $y = \\frac{1}{2}x + 2$. Pente $m = \\frac{1}{2}$, ordonnée à l'origine $p = 2$." }
          ]
        },
        {
          "id": "q2",
          "content": "Positions relatives et intersection",
          "subQuestions": [
            { "id": "sq2a", "content": "Soient $(D_1) : 2x + y = 5$ et $(D_2) : 4x + 2y = 10$. $(D_1)$ et $(D_2)$ sont-elles parallèles, confondues ou sécantes ?", "hint": "$(D_2)$ est $2 \\times (D_1)$, donc $(D_1)$ et $(D_2)$ sont confondues." },
            { "id": "sq2b", "content": "Soient $(\\Delta_1) : x + 3y = 7$ et $(\\Delta_2) : 2x - y = 0$. Déterminer leur point d'intersection.", "hint": "Du système : $y = 2x$, $x + 6x = 7$, $x = 1$, $y = 2$. Point d'intersection : $(1, 2)$." },
            { "id": "sq2c", "content": "Calculer la distance du point $C(0, 3)$ à la droite $(D_1) : 2x + y - 5 = 0$.", "hint": "$d = \\frac{|2(0) + 3 - 5|}{\\sqrt{4+1}} = \\frac{2}{\\sqrt{5}} = \\frac{2\\sqrt{5}}{5}$." }
          ]
        }
      ]
    }
  ]
}
