          "content": "$3(x^2 + y^2) - 2y = 0$",
          "hint": ""
        },
        {
          "id": "sq2_6",
          "content": "$x^2 + y^2 + x - 4y + 5 = 0$",
          "hint": ""
        },
        {
          "id": "sq2_7",
          "content": "$x^2 + y^2 - x - 3y - \\dfrac{3}{2} = 0$",
          "hint": ""
