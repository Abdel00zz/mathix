  "exercises": [
    {
      "id": "ds2s1v1-ex1",
      "number": 1,
      "theme": "généralités sur les fonctions",
      "points": 10,
      "topic": "Fonctions — Parité, monotonie et sens de variation",
      "context": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x) = x^3 - 3x$.",
      "questions": [
        {
          "id": "q1",
          "content": "Parité",
          "subQuestions": [
            { "id": "sq1a", "content": "Montrer que $f$ est impaire.", "hint": "$f(-x) = (-x)^3 - 3(-x) = -x^3 + 3x = -(x^3 - 3x) = -f(x)$." },
            { "id": "sq1b", "content": "Que peut-on en déduire pour la courbe $(C_f)$ ?", "hint": "La courbe $(C_f)$ admet l'origine $O$ comme centre de symétrie." }
          ]
        },
        {
          "id": "q2",
          "content": "Sens de variation",
          "subQuestions": [
            { "id": "sq2a", "content": "Calculer $f'(x)$ et étudier son signe.", "hint": "$f'(x) = 3x^2 - 3 = 3(x^2 - 1) = 3(x-1)(x+1)$. $f'(x) > 0$ sur $]-\\infty, -1[ \\cup ]1, +\\infty[$ et $f'(x) < 0$ sur $]-1, 1[$." },
            { "id": "sq2b", "content": "Dresser le tableau de variations de $f$.", "hint": "$f$ croissante sur $]-\\infty, -1]$, décroissante sur $[-1, 1]$, croissante sur $[1, +\\infty[$. $f(-1) = 2$, $f(1) = -2$." },
            { "id": "sq2c", "content": "Déterminer les extrema locaux de $f$.", "hint": "Maximum local en $x = -1$ : $f(-1) = 2$. Minimum local en $x = 1$ : $f(1) = -2$." }
          ]
        }
      ]
    },
    {
      "id": "ds2s1v1-ex2",
      "number": 2,
      "theme": "limites",
      "points": 10,
      "topic": "Limites de fonctions",
      "context": "",
      "questions": [
        {
          "id": "q1",
          "content": "Calcul de limites",
          "subQuestions": [
            { "id": "sq1a", "content": "Calculer $\\lim_{x \\to +\\infty} \\frac{3x^2 - x + 1}{x^2 + 2}$.", "hint": "Diviser par $x^2$ : $\\lim = \\frac{3 - \\frac{1}{x} + \\frac{1}{x^2}}{1 + \\frac{2}{x^2}} = 3$." },
            { "id": "sq1b", "content": "Calculer $\\lim_{x \\to 1} \\frac{x^2 - 1}{x - 1}$.", "hint": "$\\frac{x^2-1}{x-1} = \\frac{(x-1)(x+1)}{x-1} = x + 1 \\to 2$." },
            { "id": "sq1c", "content": "Calculer $\\lim_{x \\to 0} \\frac{\\sqrt{1+x} - 1}{x}$.", "hint": "Multiplier par le conjugué : $\\frac{(1+x) - 1}{x(\\sqrt{1+x}+1)} = \\frac{1}{\\sqrt{1+x}+1} \\to \\frac{1}{2}$." }
          ]
        },
        {
          "id": "q2",
          "content": "Asymptotes",
          "subQuestions": [
            { "id": "sq2a", "content": "Soit $g(x) = \\frac{2x+1}{x-1}$. Déterminer les asymptotes de la courbe de $g$.", "hint": "AV : $x = 1$. AH : $\\lim_{x \\to \\pm\\infty} g(x) = 2$, donc $y = 2$ est asymptote horizontale." },
            { "id": "sq2b", "content": "Étudier la position de la courbe par rapport à l'asymptote horizontale.", "hint": "$g(x) - 2 = \\frac{2x+1 - 2(x-1)}{x-1} = \\frac{3}{x-1}$. Si $x > 1$ : $g(x) > 2$. Si $x < 1$ : $g(x) < 2$." }
          ]
        }
      ]
    }
  ]
}
