  "questions": [
    {
      "id": "q1",
      "content": "Montrer que pour tout $(a;b) \\in \\mathbb{R}^2$ : $a^3 + b^3 < 1 < a+b \\Rightarrow (0 < a < 1$ et $0 < b < 1)$",
      "hint": "Raisonnez par contraposée ou par l'absurde : si $a \\leq 0$ ou $a \\geq 1$, que peut-on dire de $a^3$ par rapport à $a$ ?"
    },
    {
      "id": "q2",
      "content": "Montrer que : $(\\forall \\varepsilon > 0)(\\exists n_0 \\in \\mathbb{N})$; $\\left(n > n_0 \\Rightarrow \\left|\\dfrac{2n+1}{n+1} - 2\\right| < \\varepsilon\\right)$",
      "hint": "Simplifiez $\\left|\\dfrac{2n+1}{n+1} - 2\\right| = \\dfrac{1}{n+1}$, puis choisissez $n_0$ tel que $\\dfrac{1}{n_0+1} < \\varepsilon$."
    },
    {
      "id": "q3",
      "content": "Montrer que pour tout $(x;y) \\in \\mathbb{R}^2$ : $(|x| < 1$ et $|y| < 1) \\Rightarrow \\left|\\dfrac{x+y}{1+xy}\\right| < 1$",
      "hint": "Montrez que $1 - \\left(\\dfrac{x+y}{1+xy}\\right)^2 > 0$ en factorisant : $1 - \\dfrac{(x+y)^2}{(1+xy)^2} = \\dfrac{(1-x^2)(1-y^2)}{(1+xy)^2}$."
    }
  ]
}
