    {
      "id": "ensam-21-01",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "difficulty": "concours",
      "prompt": "La limite $\\displaystyle\\lim_{x \\to 0} \\frac{\\ln(1+x) - x}{x^2}$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$-\\frac{1}{2}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\frac{1}{2}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$1$",
          "isCorrect": false
        }
      ],
      "explanation": "DL : $\\ln(1+x) = x - \\frac{x^2}{2} + o(x^2)$. Donc $\\frac{\\ln(1+x)-x}{x^2} = \\frac{-x^2/2 + o(x^2)}{x^2} \\to -\\frac{1}{2}$."
    },
    {
      "id": "ensam-21-02",
      "type": "mcq",
      "theme": "analyse",
      "category": "Dérivation",
      "difficulty": "concours",
      "prompt": "Soit $f(x) = \\arctan(e^x)$. Alors $f'(0)$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{2}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$\\frac{\\pi}{4}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$1$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$\\frac{1}{4}$",
          "isCorrect": false
        }
      ],
      "explanation": "$f'(x) = \\frac{e^x}{1+e^{2x}}$. En $x=0$ : $f'(0) = \\frac{1}{1+1} = \\frac{1}{2}$."
    },
    {
      "id": "ensam-21-03",
      "type": "mcq",
      "theme": "analyse",
      "category": "Intégration",
      "difficulty": "concours",
      "prompt": "$\\displaystyle\\int_0^1 \\frac{x}{1+x^2}\\,dx$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{\\ln 2}{2}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$\\ln 2$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\frac{\\pi}{4}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$\\frac{1}{2}$",
          "isCorrect": false
        }
      ],
      "explanation": "$\\frac{x}{1+x^2} = \\frac{1}{2} \\cdot \\frac{2x}{1+x^2} = \\frac{1}{2}(\\ln(1+x^2))'$. Donc $I = \\frac{1}{2}[\\ln(1+x^2)]_0^1 = \\frac{\\ln 2}{2}$."
    },
