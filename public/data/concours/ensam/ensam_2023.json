      "prompt": "Le conjugué de $z = \\frac{2+i}{1-i}$ est :",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{2} + \\frac{3}{2}i$",
          "isCorrect": false
        },
        {
          "id": "b",
          "text": "$\\frac{1}{2} - \\frac{3}{2}i$",
          "isCorrect": true
        },
        {
          "id": "c",
          "text": "$\\frac{3}{2} + \\frac{1}{2}i$",
          "isCorrect": false
