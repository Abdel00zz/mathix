        {
          "id": "c",
          "text": "$\\mathbb{R}^+$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$]-\\infty, 0]$",
          "isCorrect": false
        }
      ],
      "explanation": "$f(x)=1$ si $x>0$, $f(x)=-1$ si $x<0$. En $0$ : discontinuité de saut."
