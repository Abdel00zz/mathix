  "questions": [
    {
      "id": "ensam-23-01",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "difficulty": "concours",
      "prompt": "La limite $\\displaystyle\\lim_{x \\to 0} \\frac{e^{\\sin x} - 1}{x}$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$1$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$e$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$\\frac{1}{e}$",
          "isCorrect": false
        }
      ],
      "explanation": "Équivalents : $\\sin x \\sim x$ en $0$, puis $e^u - 1 \\sim u$ en $0$. Donc $\\frac{e^{\\sin x}-1}{x} \\sim \\frac{x}{x} = 1$."
    },
    {
      "id": "ensam-23-02",
      "type": "mcq",
      "theme": "analyse",
      "category": "Dérivation",
      "difficulty": "concours",
      "prompt": "Soit $f(x) = (\\ln x)^2$. L'équation $f'(x) = 0$ a pour solution :",
      "options": [
        {
          "id": "a",
          "text": "$x = 1$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$x = e$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$x = e^2$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$x = \\frac{1}{2}$",
          "isCorrect": false
        }
      ],
      "explanation": "$f'(x) = \\frac{2\\ln x}{x}$. $f'(x) = 0 \\Leftrightarrow \\ln x = 0 \\Leftrightarrow x = 1$."
    },
    {
      "id": "ensam-23-03",
      "type": "mcq",
      "theme": "analyse",
      "category": "Suites",
      "difficulty": "concours",
      "prompt": "La limite de $u_n = \\frac{n^2+3n}{n^2-1}$ est :",
      "options": [
        {
          "id": "a",
          "text": "$1$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$3$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$+\\infty$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$0$",
          "isCorrect": false
        }
      ],
      "explanation": "On divise par $n^2$ : $u_n = \\frac{1+3/n}{1-1/n^2} \\to 1$."
    },
    {
      "id": "ensam-23-04",
      "type": "mcq",
      "theme": "analyse",
      "category": "Intégration",
      "difficulty": "concours",
      "prompt": "La valeur de $\\displaystyle\\int_0^{\\ln 2} e^{2x}\\,dx$ est :",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{3}{2}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$2$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\ln 2$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$4$",
          "isCorrect": false
        }
      ],
      "explanation": "$\\left[\\frac{e^{2x}}{2}\\right]_0^{\\ln 2} = \\frac{4}{2} - \\frac{1}{2} = \\frac{3}{2}$."
    },
    {
      "id": "ensam-23-05",
