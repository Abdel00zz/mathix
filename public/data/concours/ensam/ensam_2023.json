      "category": "Exponentielle",
      "difficulty": "concours",
      "prompt": "L'ensemble des solutions de $e^{2x} - 3e^x + 2 \\leq 0$ est :",
      "options": [
        {
          "id": "a",
          "text": "$[0, \\ln 2]$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$]-\\infty, \\ln 2]$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\{0, \\ln 2\\}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$[\\ln 2, +\\infty[$",
          "isCorrect": false
        }
      ],
      "explanation": "Posons $t = e^x > 0$. $(t-1)(t-2) \\leq 0 \\Rightarrow 1 \\leq t \\leq 2$, soit $0 \\leq x \\leq \\ln 2$."
    },
    {
      "id": "ensam-23-07",
      "type": "mcq",
