      "prompt": "Soient $a$ et $b$ deux nombres complexes tels que $a\\ne b$ et $|a|=1$. Quelle est la valeur de $\\left|\\frac{a-b}{1-\\overline{a}b}\\right|$ ?",
      "options": [
        {
          "id": "a",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "b",
          "text": "$1$",
          "isCorrect": true
        },
        {
          "id": "c",
          "text": "$2$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$\\sqrt2$",
          "isCorrect": false
        },
        {
          "id": "e",
          "text": "Aucune des réponses n'est juste",
          "isCorrect": false
        }
      ],
      "explanation": "Puisque $|a|=1$, on a $\\overline a=\\frac{1}{a}$. Alors $1-\\overline a b=\\frac{a-b}{a}$ et, comme $a\\ne b$, $\\left|\\frac{a-b}{1-\\overline a b}\\right|=|a|=1$.",
      "answerValidation": {
        "status": "verified",
        "acceptedOptionIds": [
          "b"
        ]
      }
    },
