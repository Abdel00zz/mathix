      "sourceReference": "FMP 2024 · C.22",
      "officialQuestionCode": "C.22",
      "prompt": "Soit $z=\\frac{(1-i)^{10}}{(1+i\\sqrt3)^4}$. Quelle est la bonne réponse ?",
      "options": [
        {
          "id": "a",
          "text": "$|z|=4$",
          "isCorrect": false
        },
        {
          "id": "b",
          "text": "$|z|=\\frac{1}{2}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\arg z\\equiv\\frac{\\pi}{6}\\ [2\\pi]$",
          "isCorrect": true
        },
        {
          "id": "d",
          "text": "$\\arg z\\equiv\\frac{3\\pi}{2}\\ [2\\pi]$",
          "isCorrect": false
        },
        {
          "id": "e",
          "text": "$\\arg z\\equiv\\frac{\\pi}{2}\\ [2\\pi]$",
          "isCorrect": false
        }
      ],
      "explanation": "$1-i=\\sqrt2e^{-i\\frac{\\pi}{4}}$ et $1+i\\sqrt3=2e^{i\\frac{\\pi}{3}}$. Ainsi $z=2e^{-i23\\frac{\\pi}{6}}=2e^{i\\frac{\\pi}{6}}$.",
      "answerValidation": {
        "status": "verified",
        "acceptedOptionIds": [
          "c"
        ]
      }
    },
    {
