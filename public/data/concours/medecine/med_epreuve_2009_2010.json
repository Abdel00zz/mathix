          "text": "$x^{x-1}$.",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$(1-x)x^{x-1}$.",
          "isCorrect": false
        },
        {
          "id": "e",
          "text": "${e}^x+(1-x) {e}^{x-1}$.",
          "isCorrect": false
        }
