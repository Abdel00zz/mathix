  "questions": [
    {
      "id": "ensa-23-01",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "difficulty": "concours",
      "prompt": "La limite $\\displaystyle \\lim_{x \\to 0} \\frac{\\sqrt{1+x} - \\sqrt{1-x}}{x}$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$1$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\frac{1}{2}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "N'existe pas",
          "isCorrect": false
        }
      ],
      "explanation": "Multiplication par le conjugué : $\\frac{(1+x)-(1-x)}{x(\\sqrt{1+x}+\\sqrt{1-x})} = \\frac{2}{\\sqrt{1+x}+\\sqrt{1-x}} \\xrightarrow[x\\to 0]{} \\frac{2}{2} = 1$."
    },
    {
      "id": "ensa-23-02",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "difficulty": "concours",
      "prompt": "$\\displaystyle \\lim_{x \\to 0} \\frac{\\sin(3x)}{\\tan(5x)}$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{3}{5}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$\\frac{5}{3}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$1$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$0$",
          "isCorrect": false
        }
      ],
      "explanation": "Equivalents en $0$ : $\\sin(3x) \\sim 3x$ et $\\tan(5x) \\sim 5x$. Quotient : $\\frac{3x}{5x} = \\frac{3}{5}$."
    },
    {
      "id": "ensa-23-03",
      "type": "mcq",
      "theme": "analyse",
      "category": "Limites",
      "difficulty": "concours",
      "prompt": "$\\displaystyle \\lim_{x \\to +\\infty} \\left(1 + \\frac{3}{x}\\right)^x$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$e^3$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$3e$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$+\\infty$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$1$",
          "isCorrect": false
        }
      ],
      "explanation": "$\\left(1+\\frac{3}{x}\\right)^x = e^{x\\ln(1+3/x)}$. Or $\\ln(1+u) \\sim u$ quand $u\\to 0$, donc l'exposant tend vers $3$. Limite fondamentale : $(1+a/n)^n \\to e^a$."
    },
    {
      "id": "ensa-23-04",
      "type": "mcq",
      "theme": "analyse",
      "category": "Continuité",
      "difficulty": "concours",
      "prompt": "Soit $f(x)=\\frac{e^x - 1 - x}{x^2}$ si $x \\neq 0$. Pour que $f$ soit prolongeable par continuité en $0$, on pose $f(0) =$ :",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{2}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$1$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$e$",
          "isCorrect": false
        }
      ],
      "explanation": "DL : $e^x = 1 + x + \\frac{x^2}{2} + o(x^2)$. Donc $\\frac{e^x-1-x}{x^2} \\to \\frac{1}{2}$. La règle de L'Hôpital (appliquée deux fois) donne le même résultat."
    },
    {
      "id": "ensa-23-05",
      "type": "mcq",
      "theme": "analyse",
      "category": "Dérivation",
      "difficulty": "concours",
      "prompt": "Soit $f(x) = x^x$ pour $x > 0$. Alors $f'(x)$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$x^x(\\ln x + 1)$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$x \\cdot x^{x-1}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$x^x \\ln x$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$x^{x+1}$",
          "isCorrect": false
        }
      ],
      "explanation": "On écrit $f(x) = e^{x\\ln x}$. Dérivée de la composée : $f'(x) = (\\ln x + 1) \\cdot e^{x\\ln x} = x^x(\\ln x + 1)$. Le piège est d'appliquer $(x^n)' = nx^{n-1}$ qui ne s'applique que si $n$ est constant."
    },
