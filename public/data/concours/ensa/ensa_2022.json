      "category": "Structures",
      "difficulty": "concours",
      "prompt": "Soit $G = \\{1, -1, i, -i\\}$ muni de la multiplication. L'ordre de $i$ dans $(G, \\times)$ est :",
      "options": [
        {
          "id": "a",
          "text": "$4$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$2$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$3$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$1$",
          "isCorrect": false
