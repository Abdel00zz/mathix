    {
      "id": "ensa-22-01",
      "type": "mcq",
      "theme": "analyse",
      "category": "Suites",
      "difficulty": "concours",
      "prompt": "La somme $\\displaystyle S = \\sum_{k=0}^{n} \\binom{n}{k}$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$2^n$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$n!$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$n^2$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$2n$",
          "isCorrect": false
        }
      ],
      "explanation": "Binôme de Newton avec $a=b=1$ : $\\displaystyle (1+1)^n = \\sum_{k=0}^n \\binom{n}{k} = 2^n$."
    },
    {
      "id": "ensa-22-02",
      "type": "mcq",
      "theme": "analyse",
      "category": "Logarithme",
      "difficulty": "concours",
      "prompt": "L'ensemble des solutions de $\\ln(x^2 - 3) = \\ln(2x)$ est :",
      "options": [
        {
          "id": "a",
          "text": "$\\{3\\}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$\\{-1, 3\\}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\{-1\\}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$\\emptyset$",
          "isCorrect": false
        }
      ],
      "explanation": "Domaine : $x^2-3>0$ et $x>0$, donc $x>\\sqrt{3}$. Equation : $x^2-2x-3=0$, racines $3$ et $-1$. Seul $x=3$ est dans le domaine. Piège classique : oublier de vérifier le domaine."
    },
    {
      "id": "ensa-22-03",
      "type": "mcq",
      "theme": "analyse",
      "category": "Exponentielle",
      "difficulty": "concours",
      "prompt": "Le nombre de solutions de $e^{2x} - 5e^x + 6 = 0$ est :",
      "options": [
        {
          "id": "a",
          "text": "$2$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$0$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$1$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$4$",
          "isCorrect": false
        }
      ],
      "explanation": "Posons $t = e^x > 0$. Equation : $t^2 - 5t + 6 = (t-2)(t-3) = 0$. Deux solutions $t=2$ et $t=3$, toutes deux $>0$. D'où $x = \\ln 2$ et $x = \\ln 3$."
    },
    {
      "id": "ensa-22-04",
      "type": "mcq",
      "theme": "analyse",
      "category": "Intégration",
      "difficulty": "concours",
      "prompt": "$\\displaystyle \\int_0^1 x e^{-x} \\, dx$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$1 - \\frac{2}{e}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$1 - \\frac{1}{e}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\frac{1}{e}$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$e - 2$",
          "isCorrect": false
        }
      ],
      "explanation": "IPP avec $u=x$ et $v'=e^{-x}$ : $\\displaystyle [-xe^{-x}]_0^1 + \\int_0^1 e^{-x}dx = -\\frac{1}{e} + [-e^{-x}]_0^1 = -\\frac{1}{e} - \\frac{1}{e} + 1 = 1-\\frac{2}{e}$."
    },
    {
      "id": "ensa-22-05",
      "type": "mcq",
      "theme": "analyse",
      "category": "Intégration",
      "difficulty": "concours",
      "prompt": "$\\displaystyle \\int_0^{\\pi/2} \\cos^2(x) \\, dx$ vaut :",
