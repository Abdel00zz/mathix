      "theme": "analyse",
      "category": "Exponentielle",
      "difficulty": "concours",
      "prompt": "L'aire sous la courbe $y=\\frac{1}{x}$ entre $x=1$ et $x=e^2$ vaut :",
      "options": [
        {
          "id": "a",
          "text": "$2$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$e^2 - 1$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$\\ln 2$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$e^2$",
          "isCorrect": false
        }
      ],
      "explanation": "$\\displaystyle \\int_1^{e^2} \\frac{dx}{x} = [\\ln x]_1^{e^2} = 2 - 0 = 2$."
    },
    {
