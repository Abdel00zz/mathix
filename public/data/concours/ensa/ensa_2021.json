    {
      "id": "ensa-21-01",
      "type": "mcq",
      "theme": "analyse",
      "category": "Equations différentielles",
      "difficulty": "concours",
      "prompt": "Les solutions de $y' + 2y = 0$ sont :",
      "options": [
        {
          "id": "a",
          "text": "$y = Ce^{-2x}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$y = Ce^{2x}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$y = C\\cos(2x)$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$y = -2x + C$",
          "isCorrect": false
        }
      ],
      "explanation": "$y' + ay = 0 \\Rightarrow y = Ce^{-ax}$. Ici $a=2$."
    },
    {
      "id": "ensa-21-02",
      "type": "mcq",
      "theme": "analyse",
      "category": "Equations différentielles",
      "difficulty": "concours",
      "prompt": "La solution de $y' - 3y = e^{3x}$ avec $y(0)=1$ est :",
      "options": [
        {
          "id": "a",
          "text": "$y = (x+1)e^{3x}$",
          "isCorrect": true
        },
        {
          "id": "b",
          "text": "$y = xe^{3x}$",
          "isCorrect": false
        },
        {
          "id": "c",
          "text": "$y = e^{3x} + x$",
          "isCorrect": false
        },
        {
          "id": "d",
          "text": "$y = (x+1)e^{-3x}$",
          "isCorrect": false
        }
      ],
      "explanation": "Solution homogène : $Ce^{3x}$. Variation de la constante : $C'(x)e^{3x} = e^{3x}$, donc $C(x) = x$. Générale : $y = (x+K)e^{3x}$, $y(0)=K=1$."
    },
    {
